{
  "name": "e-drive-performance-fe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint:js && npm run lint:styles",
    "lint:js": "eslint .",
    "lint:styles": "stylelint \"**/*.scss\" --allow-empty-input",
    "lint-fix": "eslint --fix . && stylelint \"**/*.scss\" --fix --allow-empty-input",
    "pre-commit": "lint-staged",
    "pre-push": "npm run format:check && npm run lint"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.scss": [
      "prettier --write",
      "stylelint --fix --rdd"
    ],
    "*.{html,css,json,yml,yaml}": "prettier --write"
  },
  "engines": {
    "node": "^24.22.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-security": "4.2.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "stylelint": "17.16.0",
    "stylelint-config-clean-order": "10.0.0",
    "stylelint-config-sass-guidelines": "13.0.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-order": "8.1.3"
  }
}
